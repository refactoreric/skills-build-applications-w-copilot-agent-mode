# Backend Environment Variables
PORT=8000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/octofit_db

# The following environment variables are automatically set by GitHub Codespaces:
# CODESPACE_NAME - The name of your codespace (e.g., opulent-journey-qgr6v76w55v3xg9j)
# When CODESPACE_NAME is set, the API base URL becomes:
# https://{CODESPACE_NAME}-8000.app.github.dev

# Frontend Environment Variables (optional)
VITE_API_BASE_URL=http://localhost:8000
# Note: The frontend auto-detects the environment and sets the correct URL
# No need to set this unless you want to override the default behavior
