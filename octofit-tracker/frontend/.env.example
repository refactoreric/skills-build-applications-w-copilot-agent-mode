# OctoFit Tracker - Frontend Environment Configuration Example
#
# Copy this file to .env.local and fill in the appropriate values.
# .env.local should never be committed to version control.
#
# For GitHub Codespaces deployment, set VITE_CODESPACE_NAME to your 
# Codespace name to enable connection to the backend API.

# GitHub Codespace Name (optional)
# When set, API calls will use: https://{CODESPACE_NAME}-8000.app.github.dev/api/...
# When unset, API calls will fallback to: http://localhost:8000/api/...
# Example: VITE_CODESPACE_NAME=smooth-spoon-p6w64
VITE_CODESPACE_NAME=
